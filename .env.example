# 비밀값을 이 파일이나 Git에 기록하지 않습니다.
API_HOST=127.0.0.1
API_PORT=9092
WEB_ORIGIN=http://127.0.0.1:9091
DATABASE_URL=

# 계정 확인 링크: 정식 전달 수단은 아직 연결하지 않았습니다.
# disabled(기본)에서는 발급을 거부합니다. mock은 development+loopback 격리 시험 전용입니다.
AUTH_DELIVERY_MODE=disabled
AUTH_LINK_ORIGIN=
# 운영 비밀키. 실제 값은 이 파일/Git/로그에 기록하지 않습니다.
AUTH_AUDIT_HMAC_KEY=
# 브라우저에 노출 가능한 API 주소만 지정합니다. 비밀값은 절대 넣지 않습니다.
NEXT_PUBLIC_API_ORIGIN=
# 초기 관리자 CLI의 사전 확인 이메일/실행 담당자. CLI에서만 읽습니다.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_OPERATOR=
